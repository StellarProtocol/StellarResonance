<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StellarLauncher.App.ViewModels"
             x:Class="StellarLauncher.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
  <StackPanel Margin="28" Spacing="14">
    <StackPanel Orientation="Horizontal" Spacing="10">
      <TextBlock Text="Settings" Foreground="White" FontSize="20" FontWeight="Bold"/>
      <TextBlock Text="{Binding LauncherVersionLabel}" Foreground="#8a93b2" FontSize="12" VerticalAlignment="Bottom"/>
    </StackPanel>

    <Border IsVisible="{Binding GameMiniDir, Converter={x:Static StringConverters.IsNullOrEmpty}}"
            Background="#1c2740" BorderBrush="#3a4f7a" BorderThickness="1" CornerRadius="8" Padding="12,10">
      <TextBlock TextWrapping="Wrap" Foreground="#cfe0ff" FontSize="12"
                 Text="👋 Set your game folder to get started — click Detect, or Browse to your install: the official …\game\release_x\game_mini folder, or your Steam &quot;Blue Protocol Star Resonance&quot; folder."/>
    </Border>

    <TextBlock Text="Game (game_mini directory)" Foreground="#8a93b2"/>
    <Grid ColumnDefinitions="*,Auto,Auto">
      <TextBox Grid.Column="0" Text="{Binding GameMiniDir}"
               PlaceholderText="auto-detected — or Detect / Browse / paste …/release_x/game_mini"/>
      <Button Grid.Column="1" Content="Detect" Command="{Binding DetectCommand}" Margin="8,0,0,0"
              Foreground="#cfe0ff" Background="#1c2740" BorderBrush="#2f4570" BorderThickness="1" FontWeight="SemiBold"/>
      <Button Grid.Column="2" Content="Browse…" Click="BrowseGame" Margin="8,0,0,0"/>
    </Grid>
    <TextBlock Text="{Binding DetectStatus}" Foreground="#7ee0a0" FontSize="11" IsVisible="{Binding DetectStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

    <StackPanel IsVisible="{Binding IsLinux}" Spacing="14">
      <TextBlock Text="Linux: Wine/Proton runner" Foreground="#8a93b2"/>
      <Grid ColumnDefinitions="*,Auto">
        <TextBox Grid.Column="0" Text="{Binding Runner}" PlaceholderText="/path/to/proton"/>
        <Button Grid.Column="1" Content="Browse…" Click="BrowseRunner" Margin="8,0,0,0"/>
      </Grid>

      <TextBlock Text="Linux: WINEPREFIX" Foreground="#8a93b2"/>
      <Grid ColumnDefinitions="*,Auto">
        <TextBox Grid.Column="0" Text="{Binding WinePrefix}" PlaceholderText="/path/to/prefix"/>
        <Button Grid.Column="1" Content="Browse…" Click="BrowsePrefix" Margin="8,0,0,0"/>
      </Grid>
    </StackPanel>

    <StackPanel IsVisible="{Binding IsLinux}" Spacing="8">
      <TextBlock Text="Linux: launch tweaks  (saved automatically — relaunch the game to apply)"
                 Foreground="#8a93b2" Margin="0,4,0,0"/>
      <CheckBox IsChecked="{Binding DxvkNvapi}" Content="Auto Install/Update DXVK-NVAPI on Prefix"
                ToolTip.Tip="Installs/updates jp7677/dxvk-nvapi into the prefix before launch, and adds the nvapi DLL overrides (NVIDIA features under DXVK)."/>
      <CheckBox IsChecked="{Binding Esync}" Content="Enable Esync"
                ToolTip.Tip="WINEESYNC — eventfd-based sync; lowers CPU overhead. Enabled by default."/>
      <CheckBox IsChecked="{Binding Fsync}" Content="Enable Fsync"
                ToolTip.Tip="WINEFSYNC — futex-based sync; faster than esync on supported kernels. Harmlessly ignored if unsupported."/>
      <StackPanel Orientation="Horizontal" Spacing="10">
        <TextBlock Text="Performance overlay" VerticalAlignment="Center"/>
        <ComboBox SelectedIndex="{Binding PerfOverlayIndex}" MinWidth="230"
                  ToolTip.Tip="Off — nothing.&#x0a;FPS counter — DXVK's built-in counter (ships with Proton, no install).&#x0a;Full overlay — MangoHud: GPU/CPU load, FPS and a frametime graph (needs the system 'mangohud' package; your own MangoHud.conf is respected).">
          <ComboBoxItem Content="Off"/>
          <ComboBoxItem Content="FPS counter (DXVK)"/>
          <ComboBoxItem Content="Full overlay (MangoHud)"/>
        </ComboBox>
      </StackPanel>
      <TextBlock IsVisible="{Binding MangoHudMissing}" Foreground="#d9a441" Margin="24,0,0,0"
                 Text="MangoHud not detected — install your distro's 'mangohud' package (the setting is kept and activates once installed)."/>
      <CheckBox IsChecked="{Binding StellarPerf}" Content="Stellar Perf overlay (advanced)"
                ToolTip.Tip="Enables the framework's in-game Stellar Perf overlay sampling (STELLAR_PERFHUD) — frame &amp; CPU times for debugging. Has a small overhead."/>

      <Expander Header="Advanced (power user)" Margin="0,8,0,0">
        <StackPanel Spacing="10" Margin="0,8,0,0">
          <TextBlock Text="Wrapper command" Foreground="#8a93b2"/>
          <TextBox Text="{Binding WrapperCommand}"
                   PlaceholderText="e.g. gamemoderun   or   gamescope -f --"
                   ToolTip.Tip="Prefixes the launch command. First token is the wrapper binary, the rest are its arguments."/>

          <TextBlock Text="Game arguments" Foreground="#8a93b2"/>
          <TextBox Text="{Binding GameArguments}"
                   PlaceholderText="extra arguments appended to the game invocation"/>

          <TextBlock Text="Pre-launch script" Foreground="#8a93b2"/>
          <Grid ColumnDefinitions="*,Auto">
            <TextBox Grid.Column="0" Text="{Binding PreLaunchScript}" PlaceholderText="/path/to/pre.sh (run &amp; waited-on before launch)"/>
            <Button Grid.Column="1" Content="Browse…" Click="BrowsePreScript" Margin="8,0,0,0"/>
          </Grid>

          <TextBlock Text="Post-exit script" Foreground="#8a93b2"/>
          <Grid ColumnDefinitions="*,Auto">
            <TextBox Grid.Column="0" Text="{Binding PostExitScript}" PlaceholderText="/path/to/post.sh (run after the game exits)"/>
            <Button Grid.Column="1" Content="Browse…" Click="BrowsePostScript" Margin="8,0,0,0"/>
          </Grid>

          <TextBlock Text="Environment variables" Foreground="#8a93b2" Margin="0,4,0,0"/>
          <ItemsControl ItemsSource="{Binding EnvVars}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:EnvVarRowViewModel">
                <Grid ColumnDefinitions="*,*,Auto" Margin="0,0,0,6">
                  <TextBox Grid.Column="0" Text="{Binding Name}" PlaceholderText="NAME"/>
                  <TextBox Grid.Column="1" Text="{Binding Value}" PlaceholderText="VALUE" Margin="8,0,0,0"/>
                  <Button Grid.Column="2" Content="🗑" Command="{Binding RemoveCommand}" Margin="8,0,0,0"
                          ToolTip.Tip="Remove this variable"/>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button Content="+ Add variable" Command="{Binding AddEnvVarCommand}" HorizontalAlignment="Left"/>
          <TextBlock Foreground="#7e88a8" FontSize="11" TextWrapping="Wrap"
                     Text="Your variables are applied last and override the launcher's defaults. WINEDLLOVERRIDES is managed — winhttp=n,b is always kept so the mod loads."/>
        </StackPanel>
      </Expander>
    </StackPanel>

    <TextBlock Text="Update channel" Foreground="#8a93b2"/>
    <ToggleSwitch IsChecked="{Binding TestingChannel}" OnContent="Testing (pre-release)" OffContent="Stable"/>

    <TextBlock Text="Game logging" Foreground="#8a93b2" Margin="0,4,0,0"/>
    <CheckBox IsChecked="{Binding DebugLogging}" Content="Debug logging (console + crash-flush + diagnostics)"
              ToolTip.Tip="Off (default) = prod: no BepInEx console, buffered disk logging, no framework diagnostics — fastest. On = console window + instant-flush logging + framework per-event diagnostics for crash triage. Applied to BepInEx.cfg and stellar_perf.flags on launch; Off also clears any leftover flags from an older install."/>

    <CheckBox IsChecked="{Binding AutoUpdateBeforeLaunch}"
              Content="Auto-update before launch (framework + plugins)"
              ToolTip.Tip="Keep the mod framework and your plugins on their newest compatible version. On by default."/>

    <TextBlock Text="Changes save automatically." Foreground="#4a5273" FontSize="11" Margin="0,6,0,0"/>
  </StackPanel>
  </ScrollViewer>
</UserControl>
