<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="StellarLauncher.App.Views.ConfirmDialog" Width="460" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" Background="#0f1426" Title="Confirm">
  <StackPanel Margin="20" Spacing="12">
    <TextBlock x:Name="TitleText" Foreground="White" FontSize="16" FontWeight="Bold"/>
    <TextBlock x:Name="BodyText" Foreground="#c5cce0" FontSize="12.5" TextWrapping="Wrap"/>
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button Classes="ghost2" Content="Cancel" Click="OnCancel"/>
      <Button x:Name="OkButton" Classes="green" Click="OnOk"/>
    </StackPanel>
  </StackPanel>
</Window>
