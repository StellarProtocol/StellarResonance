<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="using:StellarLauncher.App.ViewModels.Shell"
        xmlns:dash="using:StellarLauncher.App.ViewModels.Dashboard"
        xmlns:dashv="using:StellarLauncher.App.Views.Dashboard"
        xmlns:ws="using:StellarLauncher.App.ViewModels.Workspace"
        xmlns:wsv="using:StellarLauncher.App.Views.Workspace"
        xmlns:add="using:StellarLauncher.App.ViewModels.AddClient"
        xmlns:addv="using:StellarLauncher.App.Views.AddClient"
        xmlns:vm="using:StellarLauncher.App.ViewModels"
        xmlns:views="using:StellarLauncher.App.Views"
        x:Class="StellarLauncher.App.Views.MainWindow"
        x:DataType="shell:ShellViewModel"
        Width="1000" Height="700" MinWidth="900" MinHeight="600" Title="Stellar Launcher"
        Icon="/Assets/stellar-window.png" Background="{StaticResource WindowGroundBrush}">
  <Panel>
    <!-- cosmic ground: two soft glows behind everything -->
    <Border Background="{StaticResource GroundVioletGlow}" IsHitTestVisible="False"/>
    <Border Background="{StaticResource GroundCyanGlow}" IsHitTestVisible="False"/>

    <Grid ColumnDefinitions="200,*">
      <!-- ===== rail ===== -->
      <Border Grid.Column="0" Background="{StaticResource RailBrush}" BorderBrush="#387c5cff" BorderThickness="0,0,1,0" Padding="10,14,10,12">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Spacing="2">
            <StackPanel Orientation="Horizontal" Spacing="9" Margin="8,4,8,14">
              <Panel Width="26" Height="26">
                <Path Fill="#46d6ff" Opacity="0.8" Stretch="Uniform" Data="M12,1 L13.9,10.1 L23,12 L13.9,13.9 L12,23 L10.1,13.9 L1,12 L10.1,10.1 Z"><Path.Effect><BlurEffect Radius="5"/></Path.Effect></Path>
                <Path Fill="#d6f3ff" Stretch="Uniform" Margin="4" Data="M12,1 L13.9,10.1 L23,12 L13.9,13.9 L12,23 L10.1,13.9 L1,12 L10.1,10.1 Z"/>
              </Panel>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Stellar Launcher" Foreground="White" FontWeight="Bold" FontSize="13"/>
                <TextBlock Text="{Binding LauncherVersionLabel}" Foreground="#7f7aa8" FontSize="10"/>
              </StackPanel>
            </StackPanel>

            <Button Classes="railBtn" Command="{Binding ShowDashboardCommand}">
              <Border Classes="railItem">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Path Width="14" Height="14" Fill="#cfd3ea" Stretch="Uniform" Data="M3,13H11V3H3M3,21H11V15H3M13,21H21V11H13M13,3V9H21V3"/>
                  <TextBlock Text="Dashboard" Foreground="#e6e9f5" FontWeight="SemiBold" FontSize="12.5"/>
                </StackPanel>
              </Border>
            </Button>

            <TextBlock Text="CLIENTS" Foreground="#6f6a9a" FontSize="10" FontWeight="Bold" Margin="8,12,8,6"/>
            <ItemsControl ItemsSource="{Binding Clients}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="shell:RailClientItem">
                  <Button Classes="railBtn" Command="{Binding $parent[Window].((shell:ShellViewModel)DataContext).ShowClientCommand}" CommandParameter="{Binding}">
                    <Border Classes="railItem" Background="{Binding RowBackground}" BorderBrush="{Binding RowBorder}">
                      <Grid ColumnDefinitions="14,*,Auto" ColumnSpacing="8">
                        <Ellipse Grid.Column="0" Width="8" Height="8" Fill="{Binding DotBrush}" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1">
                          <TextBlock Text="{Binding Name}" Foreground="{Binding NameBrush}" FontWeight="SemiBold" FontSize="12.5"/>
                          <TextBlock Text="{Binding Summary}" Foreground="#697297" FontSize="10.5" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Button Grid.Column="2" Classes="quickLaunch" IsVisible="{Binding ShowQuickLaunch}"
                                ToolTip.Tip="Launch this client"
                                Command="{Binding $parent[Window].((shell:ShellViewModel)DataContext).QuickLaunchCommand}" CommandParameter="{Binding}">
                          <!-- vector triangle centres deterministically; its mass tapers right, so +2px x lands the
                               optical centre (a bare ▶ glyph sits low-left) -->
                          <Path Data="M0,0 L8,5 L0,10 Z" Fill="White" Stretch="None" Margin="2,0,0,0"
                                HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                      </Grid>
                    </Border>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button Classes="railBtn" Command="{Binding ShowAddClientCommand}">
              <Border Classes="railItem">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="＋ Add client" Foreground="#b7a8ff" FontWeight="SemiBold" FontSize="12.5"/>
                  <Border Background="#427c5cff" CornerRadius="10" Padding="6,0" IsVisible="{Binding HasCandidates}">
                    <TextBlock Text="{Binding CandidateCount}" Foreground="#e9e3ff" FontSize="10" FontWeight="Bold"/>
                  </Border>
                </StackPanel>
              </Border>
            </Button>
          </StackPanel>

          <StackPanel DockPanel.Dock="Bottom" Spacing="8">
            <Button Classes="railBtn" Command="{Binding ShowLauncherSettingsCommand}">
              <Border Classes="railItem">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Path Width="14" Height="14" Fill="#9aa3bf" Stretch="Uniform" Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97L21.54,9.37L19.66,5.27L16.56,6.05L14.5,2.42H9.5L7.44,6.05L4.34,5.27L2.46,9.37L4.57,11V12.97L2.46,14.63L4.34,18.73L7.44,17.94L9.5,21.58H14.5L16.56,17.94L19.66,18.73L21.54,14.63L19.43,12.97Z"/>
                  <TextBlock Text="Launcher settings" Foreground="#cfd3ea" FontSize="12.5"/>
                </StackPanel>
              </Border>
            </Button>
            <Border Background="#3854e3a0" BorderBrush="#7354e3a0" BorderThickness="1" CornerRadius="8" Padding="9,7" Margin="8,0"
                    IsVisible="{Binding LauncherUpdateAvailable}">
              <TextBlock Text="{Binding LauncherUpdateText}" Foreground="#b8ffe0" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap"/>
            </Border>
          </StackPanel>
          <Panel/>
        </DockPanel>
      </Border>

      <!-- ===== content ===== -->
      <ContentControl Grid.Column="1" Content="{Binding Current}">
        <ContentControl.DataTemplates>
          <!-- page templates are added by Tasks 4–10 -->
          <DataTemplate DataType="dash:DashboardViewModel"><dashv:DashboardView/></DataTemplate>
          <DataTemplate DataType="ws:ClientWorkspaceViewModel"><wsv:ClientWorkspaceView/></DataTemplate>
          <DataTemplate DataType="add:AddClientViewModel"><addv:AddClientView/></DataTemplate>
          <DataTemplate DataType="vm:LauncherSettingsViewModel"><views:LauncherSettingsView/></DataTemplate>
        </ContentControl.DataTemplates>
      </ContentControl>
    </Grid>
  </Panel>
</Window>
