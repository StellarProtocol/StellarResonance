<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StellarLauncher.App.ViewModels.Workspace" xmlns:v="using:StellarLauncher.App.Views.Workspace"
             xmlns:clients="using:StellarLauncher.Core.Clients" xmlns:loc="using:StellarLauncher.App.Localization"
             x:Class="StellarLauncher.App.Views.Workspace.ClientPluginsView" x:DataType="vm:ClientPluginsViewModel">
  <Panel>
    <DockPanel IsVisible="{Binding !IsDetailOpen}">
      <TextBlock DockPanel.Dock="Top" Text="{Binding TargetLine}" Classes="sub mono" Margin="0,0,0,8"/>
      <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10" Margin="0,0,0,10">
        <TextBox Text="{Binding Search}" PlaceholderText="{loc:T plugins.search}"/>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
          <Button Classes="tiny ghost2" Classes.ghost="{Binding IsAll}" Content="{loc:T plugins.filter.all}" Command="{Binding SetFilterCommand}" CommandParameter="{x:Static vm:PluginFilter.All}"/>
          <Button Classes="tiny ghost2" Classes.ghost="{Binding IsInstalledFilter}" Content="{Binding InstalledFilterLabel}" Command="{Binding SetFilterCommand}" CommandParameter="{x:Static vm:PluginFilter.Installed}"/>
          <Button Classes="tiny ghost2" Classes.ghost="{Binding IsUpdatesFilter}" Content="{Binding UpdatesFilterLabel}" Command="{Binding SetFilterCommand}" CommandParameter="{x:Static vm:PluginFilter.Updates}"/>
          <Button Classes="tiny ghost2" Classes.ghost="{Binding IsDisabledFilter}" Content="{Binding DisabledFilterLabel}" Command="{Binding SetFilterCommand}" CommandParameter="{x:Static vm:PluginFilter.Disabled}"/>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
          <!-- view mode: rows vs a grid of plugin cards -->
          <Button Classes="tiny ghost2" Classes.ghost="{Binding IsListView}" Content="{loc:T plugins.view.list}" Command="{Binding ShowListCommand}" ToolTip.Tip="{loc:T plugins.view.list.tip}"/>
          <Button Classes="tiny ghost2" Classes.ghost="{Binding GridView}" Content="{loc:T plugins.view.grid}" Command="{Binding ShowGridCommand}" ToolTip.Tip="{loc:T plugins.view.grid.tip}"/>
          <ComboBox ItemsSource="{Binding CopySources}" PlaceholderText="{loc:T plugins.copyFrom}" SelectionChanged="OnCopySourcePicked" MinWidth="160">
            <ComboBox.ItemTemplate><DataTemplate x:DataType="clients:ClientProfile"><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>
      </Grid>
      <TextBlock DockPanel.Dock="Top" Text="{Binding Status}" Foreground="#ffcf6b" FontSize="11.5" Margin="0,0,0,6" IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
      <ScrollViewer>
        <Panel>
        <!-- LIST view -->
        <ItemsControl ItemsSource="{Binding Rows}" IsVisible="{Binding IsListView}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:PluginRowViewModel">
              <Border Classes="card" Padding="10" Margin="0,0,0,6">
                <Grid ColumnDefinitions="34,*,160,150,Auto" ColumnSpacing="12">
                  <Border Width="34" Height="34" CornerRadius="8" ClipToBounds="True" Background="{Binding BadgeBrush}">
                    <Panel>
                      <Image Source="{Binding Item.Thumbnail}" Stretch="UniformToFill"/>
                      <TextBlock Text="{Binding Initials}" IsVisible="{Binding Item.ShowMonogram}" Foreground="White" FontWeight="ExtraBold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Panel>
                  </Border>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <WrapPanel>
                      <Button Classes="link" Content="{Binding Name}" Command="{Binding OpenCommand}" Foreground="White" FontSize="12.5" Padding="0" Margin="0,0,8,2"/>
                      <!-- 2.1.2 (owner feedback): discoverable extras — opens the detail page scrolled to
                           DEPENDENCIES. Count-based text (never a dependency's own name): robust to any name
                           length, so it can never crowd the row even at the launcher's minimum width. -->
                      <Button Classes="tag" Content="{Binding Item.ExtrasPillText}" Command="{Binding OpenDependenciesCommand}"
                              IsVisible="{Binding Item.ShowExtrasPill}" Margin="0,0,0,2"
                              ToolTip.Tip="{loc:T plugins.extras.tip}"/>
                    </WrapPanel>
                    <TextBlock Classes="sub" TextTrimming="CharacterEllipsis"><Run Text="{Binding Author}"/><Run Text=" · "/><Run Text="{Binding Description}"/></TextBlock>
                  </StackPanel>
                  <TextBlock Grid.Column="2" Text="{Binding VersionLine}" Classes="mono body" FontSize="11.5" VerticalAlignment="Center" Classes.amber="{Binding HasUpdate}"/>
                  <ItemsControl Grid.Column="3" ItemsSource="{Binding AlsoOn}" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:AlsoOnChip">
                      <Border Classes="tag" Classes.tag-mint="{Binding IsPresent}" Margin="0,0,4,4"><TextBlock Text="{Binding Text}" FontSize="10"/></Border>
                    </DataTemplate></ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button Classes="amber tiny" Content="{loc:T common.update}" Command="{Binding UpdateCommand}" IsVisible="{Binding HasUpdate}"/>
                    <Button Classes="ghost tiny" Content="{loc:T common.install}" Command="{Binding InstallCommand}" IsVisible="{Binding !IsPresent}"/>
                    <ToggleSwitch IsChecked="{Binding Enabled}" OnContent="{loc:T common.enabled}" OffContent="{loc:T common.disabled}" IsVisible="{Binding IsPresent}" FontSize="11"/>
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- GRID view: a card per plugin (cover image + details) -->
        <ItemsControl ItemsSource="{Binding Rows}" IsVisible="{Binding GridView}">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:PluginRowViewModel">
              <Border Classes="card pluginCard" Width="212" Margin="0,0,10,10" Padding="0">
                <StackPanel>
                  <Border Height="112" CornerRadius="12,12,0,0" ClipToBounds="True" Background="{Binding BadgeBrush}">
                    <Panel>
                      <Image Source="{Binding Item.Thumbnail}" Stretch="UniformToFill"/>
                      <TextBlock Text="{Binding Initials}" IsVisible="{Binding Item.ShowMonogram}" Foreground="White" FontWeight="ExtraBold" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Panel>
                  </Border>
                  <StackPanel Margin="12,10,12,12" Spacing="5">
                    <WrapPanel>
                      <Button Classes="link" Content="{Binding Name}" Command="{Binding OpenCommand}" Foreground="White" FontSize="13" FontWeight="Bold" Padding="0" Margin="0,0,8,2"/>
                      <Button Classes="tag" Content="{Binding Item.ExtrasPillText}" Command="{Binding OpenDependenciesCommand}"
                              IsVisible="{Binding Item.ShowExtrasPill}" Margin="0,0,0,2"
                              ToolTip.Tip="{loc:T plugins.extras.tip}"/>
                    </WrapPanel>
                    <TextBlock Text="{Binding Description}" Classes="sub" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" Height="30"/>
                    <TextBlock Text="{Binding VersionLine}" Classes="mono body" FontSize="11.5" Classes.amber="{Binding HasUpdate}"/>
                    <ItemsControl ItemsSource="{Binding AlsoOn}">
                      <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:AlsoOnChip">
                        <Border Classes="tag" Classes.tag-mint="{Binding IsPresent}" Margin="0,0,4,4"><TextBlock Text="{Binding Text}" FontSize="10"/></Border>
                      </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,0,0">
                      <Button Classes="amber tiny" Content="{loc:T common.update}" Command="{Binding UpdateCommand}" IsVisible="{Binding HasUpdate}"/>
                      <Button Classes="ghost tiny" Content="{loc:T common.install}" Command="{Binding InstallCommand}" IsVisible="{Binding !IsPresent}"/>
                      <ToggleSwitch IsChecked="{Binding Enabled}" OnContent="{loc:T common.enabled}" OffContent="{loc:T common.disabled}" IsVisible="{Binding IsPresent}" FontSize="11"/>
                    </StackPanel>
                  </StackPanel>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        </Panel>
      </ScrollViewer>
    </DockPanel>
    <v:PluginDetailView IsVisible="{Binding IsDetailOpen}"/>
  </Panel>
</UserControl>
