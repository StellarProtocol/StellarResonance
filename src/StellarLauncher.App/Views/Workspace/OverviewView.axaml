<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StellarLauncher.App.ViewModels.Workspace" xmlns:model="using:StellarLauncher.Core.Model" xmlns:sys="using:System"
             xmlns:loc="using:StellarLauncher.App.Localization"
             x:Class="StellarLauncher.App.Views.Workspace.OverviewView" x:DataType="vm:OverviewViewModel">
  <ScrollViewer>
    <UniformGrid Columns="2">
      <!-- Framework -->
      <Border Classes="card" Margin="0,0,12,12">
        <StackPanel Spacing="6">
          <StackPanel Orientation="Horizontal" Spacing="8"><Border Width="8" Height="8" CornerRadius="3" Background="#7c5cff"/><TextBlock Classes="h4" Text="{loc:T ov.framework}" Margin="0"/></StackPanel>
          <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="14" RowSpacing="3">
            <TextBlock Text="{loc:T ov.installed}" Classes="sub"/><TextBlock Grid.Column="1" Text="{Binding InstalledLabel}" Foreground="White" FontWeight="SemiBold"/>
            <TextBlock Grid.Row="1" Text="{loc:T ov.channel}" Classes="sub"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ChannelLabel}" Foreground="#c5cce0"/>
            <TextBlock Grid.Row="2" Text="{loc:T ov.latest}" Classes="sub"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding LatestLabel}" Foreground="#c5cce0"/>
          </Grid>
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
            <ComboBox MinWidth="170" ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion}">
              <ComboBox.ItemTemplate><DataTemplate x:DataType="model:VersionManifest">
                <StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="{Binding Version, StringFormat='v{0}'}"/><TextBlock Text="{Binding Date}" Foreground="#697297"/></StackPanel>
              </DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
            <Panel IsVisible="{Binding !ConfirmVisible}">
              <Button Classes="green" Content="{Binding ActionLabel}" Command="{Binding RequestChangeCommand}" IsEnabled="{Binding CanChangeFramework}" IsVisible="{Binding IsInstall}"/>
              <Button Classes="amber" Content="{Binding ActionLabel}" Command="{Binding RequestChangeCommand}" IsEnabled="{Binding CanChangeFramework}" IsVisible="{Binding IsUpdate}"/>
              <Button Classes="ghost2" Content="{Binding ActionLabel}" Command="{Binding RequestChangeCommand}" IsEnabled="{Binding CanChangeFramework}" IsVisible="{Binding IsReinstall}"/>
            </Panel>
            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding ConfirmVisible}">
              <TextBlock Text="{loc:T ov.downgradeWarn}" Foreground="#ffcf6b" FontSize="11" VerticalAlignment="Center" IsVisible="{Binding IsDowngrade}"/>
              <Button Classes="ghost2" Content="{loc:T common.cancel}" Command="{Binding CancelChangeCommand}"/>
              <Button Classes="green" Content="{loc:T common.confirm}" Command="{Binding ConfirmChangeCommand}"/>
            </StackPanel>
          </StackPanel>
          <TextBlock Text="{Binding Status}" Classes="sub" IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
          <ItemsControl ItemsSource="{Binding SelectedVersion.Changelog.Added}" Margin="0,6,0,0"><ItemsControl.ItemTemplate><DataTemplate x:DataType="sys:String">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="0,0,0,3"><Border Background="#2954e3a0" CornerRadius="5" Padding="6,1" VerticalAlignment="Top"><TextBlock Text="{loc:T changelog.added}" Foreground="#9affd0" FontSize="9" FontWeight="Bold"/></Border><TextBlock Grid.Column="1" Text="{Binding}" Foreground="#c5cce0" FontSize="11.5" TextWrapping="Wrap"/></Grid>
          </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
          <ItemsControl ItemsSource="{Binding SelectedVersion.Changelog.Changed}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="sys:String">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="0,0,0,3"><Border Background="#29ffcf6b" CornerRadius="5" Padding="6,1" VerticalAlignment="Top"><TextBlock Text="{loc:T changelog.changed}" Foreground="#ffcf6b" FontSize="9" FontWeight="Bold"/></Border><TextBlock Grid.Column="1" Text="{Binding}" Foreground="#c5cce0" FontSize="11.5" TextWrapping="Wrap"/></Grid>
          </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
          <ItemsControl ItemsSource="{Binding SelectedVersion.Changelog.Fixed}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="sys:String">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="0,0,0,3"><Border Background="#295b8cff" CornerRadius="5" Padding="6,1" VerticalAlignment="Top"><TextBlock Text="{loc:T changelog.fixed}" Foreground="#9ec2ff" FontSize="9" FontWeight="Bold"/></Border><TextBlock Grid.Column="1" Text="{Binding}" Foreground="#c5cce0" FontSize="11.5" TextWrapping="Wrap"/></Grid>
          </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        </StackPanel>
      </Border>
      <!-- Launch -->
      <Border Classes="card" Margin="0,0,0,12">
        <StackPanel Spacing="9">
          <StackPanel Orientation="Horizontal" Spacing="8"><Border Width="8" Height="8" CornerRadius="3" Background="#37c8e0"/><TextBlock Classes="h4" Text="{loc:T ov.launch}" Margin="0"/></StackPanel>
          <ToggleSwitch IsChecked="{Binding Modded}" OnContent="{loc:T ov.modded.on}" OffContent="{loc:T ov.modded.off}"/>
          <ToggleSwitch IsChecked="{Binding AutoUpdate}" OnContent="{loc:T ov.autoUpdate.on}" OffContent="{loc:T ov.autoUpdate.off}"/>
          <ToggleSwitch IsChecked="{Binding DebugLogging}" OnContent="{loc:T ov.debug.on}" OffContent="{loc:T ov.debug.off}"/>
          <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="14" RowSpacing="3" Margin="0,4,0,0">
            <TextBlock Text="{loc:T ov.lastLaunch}" Classes="sub"/><TextBlock Grid.Column="1" Text="{Binding LastLaunchLabel}" Foreground="#c5cce0"/>
            <TextBlock Grid.Row="1" Text="{loc:T ov.previousExit}" Classes="sub"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PreviousExitLabel}" Foreground="#c5cce0"/>
            <TextBlock Grid.Row="2" Text="{loc:T ov.interop}" Classes="sub"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding InteropLabel}" Foreground="#c5cce0"/>
          </Grid>
        </StackPanel>
      </Border>
      <!-- Plugins -->
      <Border Classes="card" Margin="0,0,12,12">
        <StackPanel Spacing="6">
          <Grid ColumnDefinitions="*,Auto"><StackPanel Orientation="Horizontal" Spacing="8"><Border Width="8" Height="8" CornerRadius="3" Background="#2dd4bf"/><TextBlock Classes="h4" Text="{loc:T ov.plugins}" Margin="0"/></StackPanel><Button Grid.Column="1" Classes="link" Content="{loc:T ov.openTab}" Command="{Binding OpenPluginsCommand}"/></Grid>
          <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="14" RowSpacing="3">
            <TextBlock Text="{loc:T ov.installed}" Classes="sub"/><TextBlock Grid.Column="1" Text="{Binding InstalledCount}" Foreground="White" FontWeight="SemiBold"/>
            <TextBlock Grid.Row="1" Text="{loc:T ov.updates}" Classes="sub"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding UpdatesLine}" Foreground="#ffcf6b"/>
            <TextBlock Grid.Row="2" Text="{loc:T ov.disabled}" Classes="sub"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DisabledCount}" Foreground="#c5cce0"/>
            <TextBlock Grid.Row="3" Text="{loc:T ov.onOthers}" Classes="sub"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding OnOthersLine}" Foreground="#c5cce0" TextWrapping="Wrap"/>
          </Grid>
        </StackPanel>
      </Border>
      <!-- Health -->
      <Border Classes="card" Margin="0,0,0,12">
        <StackPanel Spacing="6">
          <Grid ColumnDefinitions="*,Auto"><StackPanel Orientation="Horizontal" Spacing="8"><Border Width="8" Height="8" CornerRadius="3" Background="#a3e635"/><TextBlock Classes="h4" Text="{loc:T ov.health}" Margin="0"/></StackPanel><Button Grid.Column="1" Classes="link" Content="{loc:T ov.logsLink}" Command="{Binding OpenLogsCommand}"/></Grid>
          <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="14" RowSpacing="3">
            <TextBlock Text="{loc:T ov.marker}" Classes="sub"/><TextBlock Grid.Column="1" Text="{Binding MarkerLine}" Foreground="#9affd0"/>
            <TextBlock Grid.Row="1" Text="{loc:T ov.pluginFolders}" Classes="sub"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DuplicateLine}" Classes="body" Classes.amber="{Binding HasDuplicates}" TextWrapping="Wrap"/>
            <TextBlock Grid.Row="2" Text="{loc:T ov.bepinexLog}" Classes="sub"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding LogSizeLine}" Foreground="#c5cce0"/>
            <TextBlock Grid.Row="3" Text="{loc:T ov.previousExit}" Classes="sub"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding PreviousExitLabel}" Foreground="#c5cce0"/>
          </Grid>
        </StackPanel>
      </Border>
    </UniformGrid>
  </ScrollViewer>
</UserControl>
