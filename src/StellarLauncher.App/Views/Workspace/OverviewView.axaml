<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StellarLauncher.App.ViewModels.Workspace" xmlns:model="using:StellarLauncher.Core.Model" xmlns:sys="using:System"
             x:Class="StellarLauncher.App.Views.Workspace.OverviewView" x:DataType="vm:OverviewViewModel">
  <ScrollViewer>
    <UniformGrid Columns="2">
      <!-- Framework -->
      <Border Classes="card" Margin="0,0,12,12">
        <StackPanel Spacing="6">
          <StackPanel Orientation="Horizontal" Spacing="8"><Border Width="8" Height="8" CornerRadius="3" Background="#7c5cff"/><TextBlock Classes="h4" Text="FRAMEWORK" Margin="0"/></StackPanel>
          <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="14" RowSpacing="3">
            <TextBlock Text="Installed" Classes="sub"/><TextBlock Grid.Column="1" Text="{Binding InstalledLabel}" Foreground="White" FontWeight="SemiBold"/>
            <TextBlock Grid.Row="1" Text="Channel" Classes="sub"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ChannelLabel}" Foreground="#c5cce0"/>
            <TextBlock Grid.Row="2" Text="Latest" Classes="sub"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding LatestLabel}" Foreground="#c5cce0"/>
          </Grid>
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
            <ComboBox MinWidth="170" ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion}">
              <ComboBox.ItemTemplate><DataTemplate x:DataType="model:VersionManifest">
                <StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="{Binding Version, StringFormat='v{0}'}"/><TextBlock Text="{Binding Date}" Foreground="#697297"/></StackPanel>
              </DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
            <Panel IsVisible="{Binding !ConfirmVisible}">
              <Button Classes="green" Content="{Binding ActionLabel}" Command="{Binding RequestChangeCommand}" IsEnabled="{Binding CanChangeFramework}" IsVisible="{Binding IsInstall}"/>
              <Button Classes="amber" Content="{Binding ActionLabel}" Command="{Binding RequestChangeCommand}" IsEnabled="{Binding CanChangeFramework}" IsVisible="{Binding IsUpdate}"/>
              <Button Classes="ghost2" Content="{Binding ActionLabel}" Command="{Binding RequestChangeCommand}" IsEnabled="{Binding CanChangeFramework}" IsVisible="{Binding IsReinstall}"/>
            </Panel>
            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding ConfirmVisible}">
              <TextBlock Text="⚠ downgrade" Foreground="#ffcf6b" FontSize="11" VerticalAlignment="Center" IsVisible="{Binding IsDowngrade}"/>
              <Button Classes="ghost2" Content="Cancel" Command="{Binding CancelChangeCommand}"/>
              <Button Classes="green" Content="Confirm" Command="{Binding ConfirmChangeCommand}"/>
            </StackPanel>
          </StackPanel>
          <TextBlock Text="{Binding Status}" Classes="sub" IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
          <ItemsControl ItemsSource="{Binding SelectedVersion.Changelog.Added}" Margin="0,6,0,0"><ItemsControl.ItemTemplate><DataTemplate x:DataType="sys:String">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="0,0,0,3"><Border Background="#2954e3a0" CornerRadius="5" Padding="6,1" VerticalAlignment="Top"><TextBlock Text="ADDED" Foreground="#9affd0" FontSize="9" FontWeight="Bold"/></Border><TextBlock Grid.Column="1" Text="{Binding}" Foreground="#c5cce0" FontSize="11.5" TextWrapping="Wrap"/></Grid>
          </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
          <ItemsControl ItemsSource="{Binding SelectedVersion.Changelog.Changed}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="sys:String">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="0,0,0,3"><Border Background="#29ffcf6b" CornerRadius="5" Padding="6,1" VerticalAlignment="Top"><TextBlock Text="CHANGED" Foreground="#ffcf6b" FontSize="9" FontWeight="Bold"/></Border><TextBlock Grid.Column="1" Text="{Binding}" Foreground="#c5cce0" FontSize="11.5" TextWrapping="Wrap"/></Grid>
          </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
          <ItemsControl ItemsSource="{Binding SelectedVersion.Changelog.Fixed}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="sys:String">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="0,0,0,3"><Border Background="#295b8cff" CornerRadius="5" Padding="6,1" VerticalAlignment="Top"><TextBlock Text="FIXED" Foreground="#9ec2ff" FontSize="9" FontWeight="Bold"/></Border><TextBlock Grid.Column="1" Text="{Binding}" Foreground="#c5cce0" FontSize="11.5" TextWrapping="Wrap"/></Grid>
          </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        </StackPanel>
      </Border>
      <!-- Launch -->
      <Border Classes="card" Margin="0,0,0,12">
        <StackPanel Spacing="9">
          <StackPanel Orientation="Horizontal" Spacing="8"><Border Width="8" Height="8" CornerRadius="3" Background="#37c8e0"/><TextBlock Classes="h4" Text="LAUNCH" Margin="0"/></StackPanel>
          <ToggleSwitch IsChecked="{Binding Modded}" OnContent="Modded — BepInEx doorstop enabled" OffContent="Vanilla — doorstop disabled"/>
          <ToggleSwitch IsChecked="{Binding AutoUpdate}" OnContent="Auto-update framework + plugins before launch" OffContent="Auto-update before launch: off"/>
          <ToggleSwitch IsChecked="{Binding DebugLogging}" OnContent="Debug logging (console + crash flush)" OffContent="Debug logging: off"/>
          <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="14" RowSpacing="3" Margin="0,4,0,0">
            <TextBlock Text="Last launch" Classes="sub"/><TextBlock Grid.Column="1" Text="{Binding LastLaunchLabel}" Foreground="#c5cce0"/>
            <TextBlock Grid.Row="1" Text="Previous exit" Classes="sub"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PreviousExitLabel}" Foreground="#c5cce0"/>
            <TextBlock Grid.Row="2" Text="Interop set" Classes="sub"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding InteropLabel}" Foreground="#c5cce0"/>
          </Grid>
        </StackPanel>
      </Border>
      <!-- Plugins -->
      <Border Classes="card" Margin="0,0,12,12">
        <StackPanel Spacing="6">
          <Grid ColumnDefinitions="*,Auto"><StackPanel Orientation="Horizontal" Spacing="8"><Border Width="8" Height="8" CornerRadius="3" Background="#2dd4bf"/><TextBlock Classes="h4" Text="PLUGINS" Margin="0"/></StackPanel><Button Grid.Column="1" Classes="link" Content="open tab →" Command="{Binding OpenPluginsCommand}"/></Grid>
          <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="14" RowSpacing="3">
            <TextBlock Text="Installed" Classes="sub"/><TextBlock Grid.Column="1" Text="{Binding InstalledCount}" Foreground="White" FontWeight="SemiBold"/>
            <TextBlock Grid.Row="1" Text="Updates" Classes="sub"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding UpdatesLine}" Foreground="#ffcf6b"/>
            <TextBlock Grid.Row="2" Text="Disabled" Classes="sub"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DisabledCount}" Foreground="#c5cce0"/>
            <TextBlock Grid.Row="3" Text="On other clients, not here" Classes="sub"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding OnOthersLine}" Foreground="#c5cce0" TextWrapping="Wrap"/>
          </Grid>
        </StackPanel>
      </Border>
      <!-- Health -->
      <Border Classes="card" Margin="0,0,0,12">
        <StackPanel Spacing="6">
          <Grid ColumnDefinitions="*,Auto"><StackPanel Orientation="Horizontal" Spacing="8"><Border Width="8" Height="8" CornerRadius="3" Background="#a3e635"/><TextBlock Classes="h4" Text="HEALTH" Margin="0"/></StackPanel><Button Grid.Column="1" Classes="link" Content="Logs →" Command="{Binding OpenLogsCommand}"/></Grid>
          <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="14" RowSpacing="3">
            <TextBlock Text="Framework marker" Classes="sub"/><TextBlock Grid.Column="1" Text="{Binding MarkerLine}" Foreground="#9affd0"/>
            <TextBlock Grid.Row="1" Text="Plugin folders" Classes="sub"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DuplicateLine}" Classes="body" Classes.amber="{Binding HasDuplicates}" TextWrapping="Wrap"/>
            <TextBlock Grid.Row="2" Text="BepInEx log" Classes="sub"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding LogSizeLine}" Foreground="#c5cce0"/>
            <TextBlock Grid.Row="3" Text="Previous exit" Classes="sub"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding PreviousExitLabel}" Foreground="#c5cce0"/>
          </Grid>
        </StackPanel>
      </Border>
    </UniformGrid>
  </ScrollViewer>
</UserControl>
