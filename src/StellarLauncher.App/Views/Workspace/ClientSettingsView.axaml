<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StellarLauncher.App.ViewModels.Workspace" xmlns:vms="using:StellarLauncher.App.ViewModels" xmlns:loc="using:StellarLauncher.App.Localization"
             x:Class="StellarLauncher.App.Views.Workspace.ClientSettingsView" x:DataType="vm:ClientSettingsViewModel">
  <!-- HorizontalScrollBarVisibility=Disabled: the two-column card grid fits the width instead of scrolling sideways
       (owner 2026-09-11: a stray horizontal scroll pushed the vertical bar off the window edge). -->
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="0">
      <UniformGrid Columns="2">

        <!-- Identity -->
        <Border Classes="card" Margin="0,0,12,12">
          <StackPanel Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="8"><Border Width="8" Height="8" CornerRadius="3" Background="#7c5cff"/><TextBlock Classes="h4" Text="{loc:T cs.identity}" Margin="0"/></StackPanel>
            <TextBlock Text="{loc:T cs.name.label}" Classes="sub"/>
            <TextBox Text="{Binding Name}" PlaceholderText="{loc:T cs.name.placeholder}"/>
            <TextBlock Text="{loc:T cs.accent}" Classes="sub"/>
            <ItemsControl ItemsSource="{Binding Swatches}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="8"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:SwatchViewModel">
                <Button Command="{Binding PickCommand}" Padding="0" Width="22" Height="22" CornerRadius="7" Background="{Binding Brush}"
                        BorderThickness="2" Classes="swatch" Classes.selected="{Binding IsSelected}"/>
              </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding Status}" Foreground="#ffcf6b" FontSize="11.5" IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
          </StackPanel>
        </Border>

        <!-- Install -->
        <Border Classes="card" Margin="0,0,0,12">
          <StackPanel Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="8"><Border Width="8" Height="8" CornerRadius="3" Background="#37c8e0"/><TextBlock Classes="h4" Text="{loc:T cs.install}" Margin="0"/></StackPanel>
            <TextBlock Text="{loc:T cs.gameMini}" Classes="sub"/>
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
              <TextBox Text="{Binding GameMiniDir}" Classes="mono"/>
              <Button Grid.Column="1" Classes="ghost2 tiny" Content="{loc:T cs.detect}" Command="{Binding DetectCommand}"/>
              <Button Grid.Column="2" Classes="ghost2 tiny" Content="{loc:T common.browse}" Click="BrowseGame"/>
            </Grid>
            <TextBlock Text="{Binding LayoutLine}" Classes="sub" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>

        <!-- Updates -->
        <Border Classes="card" Margin="0,0,12,12">
          <StackPanel Spacing="9">
            <StackPanel Orientation="Horizontal" Spacing="8"><Border Width="8" Height="8" CornerRadius="3" Background="#ffcf6b"/><TextBlock Classes="h4" Text="{loc:T cs.updates}" Margin="0"/></StackPanel>
            <ToggleSwitch IsChecked="{Binding TestingChannel}" OnContent="{loc:T settings.channel.testing}" OffContent="{loc:T channel.stable}"/>
            <CheckBox IsChecked="{Binding AutoUpdate}" Content="{loc:T ov.autoUpdate.on}"/>
            <CheckBox IsChecked="{Binding DebugLogging}" Content="{loc:T ov.debug.on}"/>
          </StackPanel>
        </Border>

        <!-- Linux runtime -->
        <Border Classes="card" Margin="0,0,0,12" IsVisible="{Binding IsLinux}">
          <StackPanel Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="8"><Border Width="8" Height="8" CornerRadius="3" Background="#2dd4bf"/><TextBlock Classes="h4" Text="{loc:T cs.linuxRuntime}" Margin="0"/></StackPanel>
            <TextBlock Text="{loc:T cs.runner}" Classes="sub"/>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBox Text="{Binding Runner}" Classes="mono" PlaceholderText="/path/to/GE-Proton/proton"/>
              <Button Grid.Column="1" Classes="ghost2 tiny" Content="{loc:T common.browse}" Click="BrowseRunner"/>
            </Grid>
            <TextBlock Text="WINEPREFIX" Classes="sub"/>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBox Text="{Binding WinePrefix}" Classes="mono" PlaceholderText="/path/to/prefix"/>
              <Button Grid.Column="1" Classes="ghost2 tiny" Content="{loc:T common.browse}" Click="BrowsePrefix"/>
            </Grid>
            <TextBlock Text="{Binding UmuLine}" Classes="sub" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>

        <!-- Linux tweaks -->
        <Border Classes="card" Margin="0,0,12,12" IsVisible="{Binding IsLinux}">
          <StackPanel Spacing="9">
            <StackPanel Orientation="Horizontal" Spacing="8"><Border Width="8" Height="8" CornerRadius="3" Background="#a3e635"/><TextBlock Classes="h4" Text="{loc:T cs.linuxTweaks}" Margin="0"/></StackPanel>
            <CheckBox IsChecked="{Binding DxvkNvapi}" Content="{loc:T cs.dxvkNvapi}"/>
            <CheckBox IsChecked="{Binding Esync}" Content="Esync"/>
            <CheckBox IsChecked="{Binding Fsync}" Content="Fsync"/>
            <TextBlock Text="{loc:T cs.perfOverlay}" Classes="sub"/>
            <ComboBox SelectedIndex="{Binding PerfOverlayIndex}" MinWidth="220">
              <ComboBoxItem Content="{loc:T cs.perfOverlay.off}"/>
              <ComboBoxItem Content="{loc:T cs.perfOverlay.fps}"/>
              <ComboBoxItem Content="{loc:T cs.perfOverlay.full}"/>
            </ComboBox>
            <TextBlock Text="{loc:T cs.mangoHudMissing}" Foreground="#ffcf6b" FontSize="11.5" TextWrapping="Wrap" IsVisible="{Binding MangoHudMissing}"/>
            <CheckBox IsChecked="{Binding StellarPerf}" Content="{loc:T cs.stellarPerf}"/>
          </StackPanel>
        </Border>

        <!-- Advanced -->
        <Border Classes="card" Margin="0,0,0,12">
          <StackPanel Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="8"><Border Width="8" Height="8" CornerRadius="3" Background="#ff6ec7"/><TextBlock Classes="h4" Text="{loc:T cs.advanced}" Margin="0"/></StackPanel>
            <TextBlock Text="{loc:T cs.wrapper}" Classes="sub"/>
            <TextBox Text="{Binding Wrapper}" Classes="mono"/>
            <TextBlock Text="{loc:T cs.gameArgs}" Classes="sub"/>
            <TextBox Text="{Binding GameArgs}" Classes="mono"/>
            <TextBlock Text="{loc:T cs.preLaunch}" Classes="sub"/>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBox Text="{Binding PreLaunch}" Classes="mono"/>
              <Button Grid.Column="1" Classes="ghost2 tiny" Content="{loc:T common.browse}" Click="BrowsePre"/>
            </Grid>
            <CheckBox IsChecked="{Binding PreLaunchParallel}" Content="{loc:T cs.preLaunchParallel}"/>
            <TextBlock Text="{loc:T cs.postExit}" Classes="sub"/>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBox Text="{Binding PostExit}" Classes="mono"/>
              <Button Grid.Column="1" Classes="ghost2 tiny" Content="{loc:T common.browse}" Click="BrowsePost"/>
            </Grid>
            <TextBlock Text="{loc:T cs.envVars}" Classes="sub" Margin="0,4,0,0"/>
            <ItemsControl ItemsSource="{Binding EnvVars}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vms:EnvVarRowViewModel">
                  <Grid ColumnDefinitions="*,*,Auto" Margin="0,0,0,6">
                    <TextBox Grid.Column="0" Text="{Binding Name}" PlaceholderText="NAME" Classes="mono"/>
                    <TextBox Grid.Column="1" Text="{Binding Value}" PlaceholderText="VALUE" Classes="mono" Margin="8,0,0,0"/>
                    <Button Grid.Column="2" Classes="ghost2 tiny" Content="🗑" Command="{Binding RemoveCommand}" Margin="8,0,0,0" ToolTip.Tip="{loc:T cs.envVar.remove}"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Classes="ghost2 tiny" Content="{loc:T cs.envVar.add}" Command="{Binding AddEnvVarCommand}" HorizontalAlignment="Left"/>
            <TextBlock Classes="sub" TextWrapping="Wrap"
                       Text="{loc:T cs.envVars.note}"/>
          </StackPanel>
        </Border>
      </UniformGrid>

      <!-- Footer -->
      <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,4,0,18">
        <Button Classes="link link-red" Content="{loc:T cs.removeClient}" Command="{Binding RemoveClientCommand}"/>
        <TextBlock Classes="sub" Text="{loc:T cs.removeClient.note}" VerticalAlignment="Center"/>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
