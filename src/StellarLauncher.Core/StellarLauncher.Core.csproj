<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.IO.Abstractions" Version="22.1.1" />
  </ItemGroup>

  <!-- Launcher UI catalogs (Localization/LauncherLocalization): one flat key→string JSON per language. -->
  <ItemGroup>
    <EmbeddedResource Include="Localization\Lang\*.json" LogicalName="StellarLauncher.Lang.%(Filename).json" />
  </ItemGroup>

</Project>
